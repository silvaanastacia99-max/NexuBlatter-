<title>NexusBlatter 3D - Anime Battle Royale</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:radial-gradient(circle at top,#164d75,#06101e 65%);
 color:white;
 min-height:100vh;
 text-align:center;
}
.screen{
 display:none;
 min-height:100vh;
 padding:25px 15px;
 align-items:center;
 justify-content:center;
 flex-direction:column;
}
.screen.active{display:flex}
.logo{
 font-size:clamp(35px,9vw,65px);
 font-weight:1000;
 color:#21e7ff;
 text-shadow:0 0 18px #00bfff;
}
.subtitle{
 color:#ffd83d;
 font-weight:bold;
 letter-spacing:4px;
 margin:15px 0 35px;
}
button{
 border:0;
 border-radius:12px;
 padding:16px 25px;
 font-size:17px;
 font-weight:bold;
 cursor:pointer;
 color:#061426;
 background:linear-gradient(90deg,#19e5ff,#ffd52d);
 box-shadow:0 0 15px #00cfff66;
 margin:10px;
}
button:active{transform:scale(.96)}
h2{color:#25eaff}
.characters{
 display:grid;
 grid-template-columns:repeat(2,minmax(130px,1fr));
 gap:13px;
 width:100%;
 max-width:500px;
}
.character{
 background:#102941;
 border:2px solid #286080;
 border-radius:15px;
 padding:12px;
 cursor:pointer;
}
.character.selected{
 border:3px solid #ffe12e;
 background:#164b63;
 box-shadow:0 0 18px #00dfff;
}
.character .portrait{
 height:115px;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:75px;
}
.character strong{display:block;margin:8px}
.character small{color:#a9d9ee}
#chosen{color:#ffe12e;font-size:19px}
.note{color:#a9c9dd;font-size:13px}
</style>
</head>

<body>

