<section id="inicio" class="screen active">
 <div class="logo">NEXUSBLATTER 3D</div>
 <div class="subtitle">ANIME BATTLE ROYALE</div>
 <p>Prepare-se para entrar no universo dos animes!</p>
 <button onclick="abrirSelecao()">ENTRAR NO JOGO</button>
</section>

<!-- ESCOLHA DE PERSONAGEM -->
<section id="selecao" class="screen">
 <h1>ESCOLHA SEU PERSONAGEM</h1>
 <p>Selecione seu guerreiro favorito</p>

 <div class="characters">

  <div class="character selected" onclick="selecionar(this,'Naruto')">
   <div class="portrait">🍥</div>
   <strong>NARUTO</strong>
   <small>Ninja lendário</small>
  </div>

  <div class="character" onclick="selecionar(this,'Luffy')">
   <div class="portrait">🏴‍☠️</div>
   <strong>LUFFY</strong>
   <small>Rei dos piratas</small>
  </div>

  <div class="character" onclick="selecionar(this,'Zoro')">
   <div class="portrait">⚔️</div>
   <strong>ZORO</strong>
   <small>Espadachim</small>
  </div>

  <div class="character" onclick="selecionar(this,'Nami')">
   <div class="portrait">🌩️</div>
   <strong>NAMI</strong>
   <small>Navegadora</small>
  </div>

  <div class="character" onclick="selecionar(this,'Sasuke')">
   <div class="portrait">⚡</div>
   <strong>SASUKE</strong>
   <small>Ninja poderoso</small>
  </div>

  <div class="character" onclick="selecionar(this,'Guerreiro Nexus')">
   <div class="portrait">🔥</div>
   <strong>GUERREIRO NEXUS</strong>
   <small>Guerreiro original</small>
  </div>

 </div>

 <p>Personagem escolhido: <span id="chosen">Naruto</span></p>

 <button onclick="confirmar()">CONFIRMAR PERSONAGEM</button>
 <button onclick="voltar()">VOLTAR</button>
</section>

<!-- PERSONAGEM CONFIRMADO -->
<section id="confirmado" class="screen">
 <h1>PERSONAGEM CONFIRMADO!</h1>
 <div class="logo" style="font-size:35px" id="nomeFinal">NARUTO</div>
 <p>Seu guerreiro está preparado!</p>
 <button onclick="jogar()">JOGAR</button>
 <button onclick="abrirSelecao()">TROCAR PERSONAGEM</button>
</section>

<script>
let personagem="Naruto";

function mostrar(id){
 document.querySelectorAll(".screen").forEach(t=>{
  t.classList.remove("active");
 });
 document.getElementById(id).classList.add("active");
}

function abrirSelecao(){
 mostrar("selecao");
}

function selecionar(elemento,nome){
 personagem=nome;
 document.querySelectorAll(".character").forEach(c=>{
  c.classList.remove("selected");
 });
 elemento.classList.add("selected");
 document.getElementById("chosen").textContent=nome;
}

function voltar(){
 mostrar("inicio");
}

function confirmar(){
 document.getElementById("nomeFinal").textContent=personagem;
 mostrar("confirmado");
}

function jogar(){
 alert("Personagem "+personagem+" selecionado! A próxima etapa será conectar esta tela à batalha 3D.");
}
</script>

</body>
</html>
="hud">
 <div id="topo">
  <div class="painel">❤️ VIDA<div id="barraFundo"><div id="barraVida"></div></div></div>
  <div class="painel" id="pontos">Pontos: 0</div>
