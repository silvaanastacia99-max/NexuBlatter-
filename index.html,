const sphere=(r,s=16)=>new THREE.SphereGeometry(r,s,12);

function capsuleBetween(group,a,b,r,material){
 const A=new THREE.Vector3(...a);
 const B=new THREE.Vector3(...b);
 const dir=new THREE.Vector3().subVectors(B,A);
 const length=dir.length();
 const obj=mesh(
  new THREE.CapsuleGeometry(r,Math.max(.05,length-2*r),5,10),
  material,0,0,0,group
 );
 obj.position.copy(A).add(B).multiplyScalar(.5);
 obj.quaternion.setFromUnitVectors(
  new THREE.Vector3(0,1,0),dir.normalize()
 );
 return obj;
}

function makeHumanoid(h,enemy=false){
 const g=new THREE.Group();

 const cloth=mat(enemy?0x873448:h.color);
 const skin=mat(h.skin);
 const hair=mat(h.hair);
 const trim=mat(h.accent);
 const dark=mat(0x20232c);
 const boot=mat(0x24252a);
 const white=mat(0xf7eee2);
 const eye=mat(0x24202a);

 // Corpo
 const torso=mesh(
  new THREE.CapsuleGeometry(.43,.68,8,14),
  cloth,0,1.45,0,g
 );
 torso.scale.set(1.18,1,.72);

 mesh(new THREE.SphereGeometry(.34,16,14),
 cloth,0,.92,0,g).scale.set(1,.62,.75);

 // Pescoço e cabeça
 mesh(new THREE.CylinderGeometry(.13,.16,.22,14),
 skin,0,2.02,0,g);

 mesh(sphere(.34,24),skin,0,2.34,0,g)
 .scale.set(.88,1.12,.86);

 for(const s of [-1,1]){
  mesh(sphere(.09,12),skin,s*.31,2.34,0,g);
 }

 // Cabelo
 mesh(sphere(.355,20),hair,0,2.58,-.025,g)
 .scale.set(1.02,.62,.98);

 for(let k=0;k<9;k++){
  const a=k/9*Math.PI*2;
  const spike=mesh(
   new THREE.ConeGeometry(.105,.38,9),
   hair,Math.cos(a)*.22,2.76,Math.sin(a)*.22,g
  );
  spike.rotation.z=Math.cos(a)*-.45;
  spike.rotation.x=Math.sin(a)*.4;
 }

 // Rosto
 for(const s of [-1,1]){
  mesh(sphere(.075,12),white,s*.12,2.38,.285,g);
  mesh(sphere(.042,12),eye,s*.12,2.38,.345,g);
  mesh(sphere(.015,8),white,s*.105,2.4,.38,g);

  const brow=mesh(
   new THREE.CapsuleGeometry(.025,.12,3,8),
   hair,s*.12,2.49,.29,g
  );
  brow.rotation.z=s*-.15;
 }

 const mouth=mesh(
  new THREE.CapsuleGeometry(.018,.09,3,8),
  mat(0x743c3b),0,2.19,.303,g
 );
 mouth.rotation.z=Math.PI/2;

 // Braços articulados
 const limbs=[];
 for(const s of [-1,1]){
  mesh(sphere(.22,14),cloth,s*.48,1.77,0,g);

  const upper=capsuleBetween(
   g,[s*.5,1.72,0],[s*.66,1.25,.04],.14,cloth
  );

  const lower=capsuleBetween(
   g,[s*.66,1.25,.04],[s*.72,.91,.12],.115,skin
  );

  mesh(sphere(.13,12),skin,s*.72,.86,.13,g);

  limbs.push({upper,lower,side:s});
 }

 // Pernas
 const legs=[];
 for(const s of [-1,1]){
  const upper=capsuleBetween(
   g,[s*.2,.92,0],[s*.22,.48,0],.19,cloth
  );
  const lower=capsuleBetween(
   g,[s*.22,.48,0],[s*.23,.16,.03],.145,boot
  );
  mesh(new THREE.SphereGeometry(.19,14,10),
   boot,s*.23,.12,.13,g).scale.set(1,.55,1.35);
  legs.push({upper,lower,side:s});
 }

 // Gola e cinto
 mesh(new THREE.TorusGeometry(.28,.055,8,18),
 trim,0,1.94,0,g).rotation.x=Math.PI/2;

 mesh(new THREE.TorusGeometry(.3,.045,8,18),
 dark,0,1.03,0,g).rotation.x=Math.PI/2;

 // Arma simples 3D
 const weapon=new THREE.Group();
 mesh(new THREE.CylinderGeometry(.045,.045,.65,10),
 dark,.75,1.13,.30,weapon);
 mesh(new THREE.CylinderGeometry(.07,.07,.16,10),
 mat(0x999da5),.75,1.48,.30,weapon);
 mesh(new THREE.CylinderGeometry(.055,.055,.20,10),
 mat(0x252b35),.75,.72,.30,weapon);
 g.add(weapon);

 // Capa
 if(["Zoro","Ichigo","Tanjiro"].includes(h.name)){
  const cape=mesh(
   new THREE.ConeGeometry(.48,.85,12,1,true),
   trim,0,1.43,-.38,g
  );
  cape.rotation.x=Math.PI;
 }

 g.userData={limbs,legs};
 return g;
}

