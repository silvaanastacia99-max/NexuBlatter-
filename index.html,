function createEnemy(x,z){
 const h={
  ...heroes[2],
  color:0x96374a,
  hair:0x211a24
 };

 const obj=makeHumanoid(h,true);

 obj.position.set(x,0,z);
 scene.add(obj);

 return {
  obj,
  hp:3,
  alive:true,
  speed:2,
  attackTime:0
 };
}

function updateHUD(){
