const trunk=mat(0x68452d);
const leaf=mat(0x286c3b);
const wall=mat(0xc7b18b);
const roof=mat(0x80483c);
const glass=mat(0x70cce0,.25,{metalness:.15});

function mesh(g,m,x,y,z,parent=scene){
 const o=new THREE.Mesh(g,m);
 o.position.set(x,y,z);
 o.castShadow=true;
 o.receiveShadow=true;
 parent.add(o);
 return o;
}

function tree(x,z){
 const g=new THREE.Group();
 mesh(new THREE.CylinderGeometry(.22,.36,2.3,12),trunk,0,1.15,0,g);
 for(let i=0;i<3;i++){
  const crown=mesh(
   new THREE.SphereGeometry(1.15-i*.12,16,12),
   leaf,0,2.5+i*.72,0,g
  );
  crown.scale.set(1,1.05,1);
 }
 g.position.set(x,0,z);
 scene.add(g);
}

function house(x,z){
 const g=new THREE.Group();
 mesh(new THREE.BoxGeometry(7,3.5,6),wall,0,1.75,0,g);
 mesh(new THREE.ConeGeometry(5.2,2.3,4),roof,0,4.5,0,g).rotation.y=Math.PI/4;
 mesh(new THREE.BoxGeometry(1.25,2.2,.12),trunk,0,1.1,-3.06,g);
 for(const sx of [-2,2])
  mesh(new THREE.BoxGeometry(1.1,1,.1),glass,sx,2,-3.08,g);
 g.position.set(x,0,z);
 scene.add(g);
}

for(let i=0;i<65;i++){
