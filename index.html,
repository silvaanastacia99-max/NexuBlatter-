document.body.insertBefore(renderer.domElement,document.body.firstChild);

scene.add(new THREE.HemisphereLight(0xdaf3ff,0x536044,1.8));

const sun=new THREE.DirectionalLight(0xfff1dc,2);
sun.position.set(-25,45,20);
sun.castShadow=true;
sun.shadow.mapSize.set(1024,1024);
scene.add(sun);

const mat=(c,r=.78,extra={})=>
 new THREE.MeshStandardMaterial({color:c,roughness:r,...extra});

const ground=new THREE.Mesh(
 new THREE.PlaneGeometry(190,190),mat(0x54864b)
a
const path=new THREE.Mesh(
