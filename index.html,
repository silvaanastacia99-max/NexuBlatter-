function especial(){
 if(!iniciou||acabou)return;
 if(performance.now()-tempoEspecial<4500){
  aviso("PODER RECARREGANDO!");
  return;
 }

 tempoEspecial=performance.now();

 const onda=new THREE.Mesh(
  new THREE.SphereGeometry(1,20,16),
  new THREE.MeshBasicMaterial({color:0x39dfff,wireframe:true,transparent:true,opacity:.7})
 );
 onda.position.copy(jogador.position);
 onda.position.y=1;
 cena.add(onda);

 let tamanho=1;
 const anim=setInterval(()=>{
  tamanho+=.8;
  onda.scale.setScalar(tamanho);
  onda.material.opacity-=.12;
  if(tamanho>10){
   clearInterval(anim);
   cena.remove(onda);
   onda.geometry.dispose();
   onda.material.dispose();
  }
 },35);

 inimigos.forEach(e=>{
  if(e.vivo&&jogador.position.distanceTo(e.obj.position)<9)atingirInimigo(e,65);
 });
 aviso("PODER ESPECIAL!");
}

