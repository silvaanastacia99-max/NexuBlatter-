<canvas id="minimapa" width="100" height="100"></canvas>
<div id="miraVisual"><div id="miralinha1"></div><div id="miralinha2"></div></div>

<div id="controles">
 <div id="joystick"><div id="pino"></div></div>
 <div class="botoes">
  <button class="btn" id="btnPulo">PULAR</button>
  <div class="linha">
   <button class="btn" id="btnMira">MIRA</button>
