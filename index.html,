/* DANO */

function atingirInimigo(e,dano){
 if(!e.vivo)return;

 e.vida=Math.max(0,e.vida-dano);
 pontos+=10;

 const escala=Math.max(.02,e.vida/100);
 e.barra.barra.scale.x=escala;
 e.barra.barra.position.x=-(1.15*(1-escala))/2;

 if(e.vida<=0){
  e.vivo=false;
  e.obj.visible=false;
  e.barra.grupo.visible=false;
  pontos+=90;
  aviso("ADVERSÁRIO DERROTADO!");
 }

 atualizarHUD();
 if(inimigos.every(x=>!x.vivo))mostrarFim(true);
}

/* SOM DE DISPARO */

let audio=null;

function somTiro(){
 try{
  if(!audio)audio=new (window.AudioContext||window.webkitAudioContext)();
  if(audio.state==="suspended")audio.resume();

  const osc=audio.createOscillator();
  const gain=audio.createGain();
  osc.type="sawtooth";
  osc.frequency.setValueAtTime(150,audio.currentTime);
  osc.frequency.exponentialRampToValueAtTime(45,audio.currentTime+.12);
  gain.gain.setValueAtTime(.18,audio.currentTime);
  gain.gain.exponentialRampToValueAtTime(.001,audio.currentTime+.13);
  osc.connect(gain);
  gain.connect(audio.destination);
  osc.start();
  osc.stop(audio.currentTime+.14);
 }catch(e){}
}

/* DISPARO */

function criarDisparo(){
 if(!iniciou||acabou||recarregando)return;
 if(performance.now()-tempoAtaque<300)return;

 if(municao<=0){
  aviso("SEM MUNIÇÃO!");
  return;
 }

 tempoAtaque=performance.now();
 municao--;
 somTiro();

 const direcao=new THREE.Vector3(Math.sin(cameraAngulo),0,Math.cos(cameraAngulo));
 jogador.rotation.y=cameraAngulo;

 const origem=jogador.position.clone();
 origem.y+=1.45;
 origem.addScaledVector(direcao,.8);

 const candidatos=inimigos.filter(e=>e.vivo).map(e=>{
  const delta=e.obj.position.clone().sub(origem);
  delta.y=0;
  return {e,delta,dist:delta.length()};
 }).filter(a=>a.dist<48&&a.dist>.01&&a.delta.normalize().dot(direcao)>.91)
 .sort((a,b)=>a.dist-b.dist);

 let fim=origem.clone().addScaledVector(direcao,48);

 if(candidatos.length){
  const alvo=candidatos[0];
  fim=alvo.e.obj.position.clone();
  fim.y+=1.4;
  atingirInimigo(alvo.e,34);
 }

 const geometria=new THREE.BufferGeometry().setFromPoints([origem.clone(),fim.clone()]);
 const linha=new THREE.Line(geometria,new THREE.LineBasicMaterial({color:0xffe77a}));
 cena.add(linha);
 balas.push({obj:linha,fim:performance.now()+100});
 atualizarHUD();
}

/* RECARGA */

function recarregar(){
 if(!iniciou||acabou||recarregando)return;
 if(municao===12||reserva<=0)return;

 recarregando=true;
 document.getElementById("ajuda").textContent="RECARREGANDO...";

 setTimeout(()=>{
  if(acabou){recarregando=false;return;}
  const falta=12-municao;
  const quantidade=Math.min(falta,reserva);
  municao+=quantidade;
  reserva-=quantidade;
  recarregando=false;
  atualizarHUD();
  document.getElementById("ajuda").textContent="PRONTO PARA COMBATER!";
 },1300);
}

