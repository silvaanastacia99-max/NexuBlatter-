/* COMBATE */

function hitEnemy(e,damage){
 if(!e.alive)return;

 e.hp-=damage;
 score+=10;

 e.obj.scale.set(1.08,.96,1.08);

 setTimeout(()=>{
  if(e.obj)e.obj.scale.set(1,1,1);
 },100);

 if(e.hp<=0){
  e.alive=false;
  e.obj.visible=false;
  score+=90;

  document.getElementById("ajuda").textContent=
   "Adversário derrotado!";
 }
}

function createShotEffect(target){
 const start=player.position.clone();
 start.y+=1.5;

 const end=target?
  target.obj.position.clone().add(new THREE.Vector3(0,1.4,0)):
  start.clone().add(
   new THREE.Vector3(
    Math.sin(camAngle),0,Math.cos(camAngle)
   ).multiplyScalar(8)
  );

 const geometry=new THREE.BufferGeometry().setFromPoints([
  start,end
 ]);

 const line=new THREE.Line(
  geometry,
  new THREE.LineBasicMaterial({
   color:0xffed80,
   transparent:true,
   opacity:1
  })
 );

 scene.add(line);

 setTimeout(()=>{
  scene.remove(line);
  geometry.dispose();
 },100);
}

function shoot(){
 if(!started||ended||reloading)return;

 if(performance.now()-shotAt<320)return;

 if(ammo<=0){
  document.getElementById("ajuda").textContent=
   "Sem munição! Recarregue.";
  return;
 }

 shotAt=performance.now();
 ammo--;

 const forward=new THREE.Vector3(
  Math.sin(camAngle),0,Math.cos(camAngle)
 );

 let target=null;
 let best=8;

 enemies.forEach(e=>{
  if(!e.alive)return;

  const delta=e.obj.position.clone().sub(player.position);
  const dist=delta.length();

  delta.y=0;
  delta.normalize();

  if(forward.dot(delta)>.72&&dist<best){
   best=dist;
   target=e;
  }
 });

 createShotEffect(target);

 if(target)hitEnemy(target,1);

 updateHUD();

 if(enemies.every(e=>!e.alive))endGame(true);
}

function special(){
 if(!started||ended)return;

 if(performance.now()-powerAt<4500){
  document.getElementById("ajuda").textContent=
   "Poder recarregando!";
  return;
 }

 powerAt=performance.now();

 enemies.forEach(e=>{
  if(e.alive&&player.position.distanceTo(e.obj.position)<9){
   hitEnemy(e,2);
  }
 });

 updateHUD();

 document.getElementById("ajuda").textContent=
  heroes[selected].power+" ativado!";

 if(enemies.every(e=>!e.alive))endGame(true);
}

function reload(){
 if(!started||ended||reloading||ammo===12||reserve<=0)return;

 reloading=true;

 document.getElementById("ajuda").textContent=
  "Recarregando...";

 setTimeout(()=>{
  if(ended)return;

  const n=Math.min(12-ammo,reserve);

  ammo+=n;
  reserve-=n;
  reloading=false;

  updateHUD();

  document.getElementById("ajuda").textContent=
   "Munição carregada!";
 },1100);
}

function jump(){
 if(!started||ended||jumping)return;

 jumping=true;
 jumpV=7;
}

