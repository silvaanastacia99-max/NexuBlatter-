/* JOYSTICK */

const joy=document.getElementById("joystick");
const pin=document.getElementById("pino");

function movePin(e){
 const r=joy.getBoundingClientRect();

 let x=e.clientX-(r.left+r.width/2);
 let y=e.clientY-(r.top+r.height/2);

 const lim=36;
 const d=Math.hypot(x,y);

 if(d>lim){
  x=x/d*lim;
  y=y/d*lim;
 }

 move.x=x/lim;
 move.y=y/lim;

 const offset=joy.offsetWidth===92?25:35;

 pin.style.left=(offset+x)+"px";
 pin.style.top=(offset+y)+"px";
}

joy.onpointerdown=e=>{
 e.preventDefault();

 joyOn=true;
 joyId=e.pointerId;

 joy.setPointerCapture(e.pointerId);
 movePin(e);
};

joy.onpointermove=e=>{
 if(joyOn&&e.pointerId===joyId)movePin(e);
};

function stopJoy(){
 joyOn=false;
 move.x=0;
 move.y=0;

 const offset=joy.offsetWidth===92?25:35;

 pin.style.left=offset+"px";
 pin.style.top=offset+"px";
}

joy.onpointerup=stopJoy;
joy.onpointercancel=stopJoy;

