let health=100;
let score=0;
let started=false;
let ended=false;
let ammo=12;
let reserve=60;
let reloading=false;
let shotAt=0;
let powerAt=0;
let jumpV=0;
let jumping=false;
let camAngle=0;
let drag=false;
let lastX=0;
let animTime=0;

const keys={};
const move={x:0,y:0};
let joyOn=false;
let joyId=null;

function createEnemy(x,z){
 const h={...heroes[2],color:0x96374a,hair:0x211a24};
 const obj=makeHumanoid(h,true);
 obj.position.set(x,0,z);
 scene.add(obj);
 return {obj,hp:3,alive:true,speed:2,hit:0};
}

function updateHUD(){
 document.getElementById("barraVida").style.width=health+"%";
 document.getElementById("pontos").textContent="Pontos: "+score;
 document.getElementById("inimigosTexto").textContent=
  "Inimigos: "+enemies.filter(e=>e.alive).length;
 document.getElementById("municao").textContent=
  ammo+" / "+reserve;
}

function endGame(win){
 if(ended)return;
 ended=true;
 document.getElementById("mensagem").style.display="flex";
 document.getElementById("caixa").innerHTML=`
 <h1>${win?"VOCÊ VENCEU!":"FIM DE JOGO"}</h1>
 <p>${win?"Você derrotou todos os adversários!":"Sua aventura terminou. Tente novamente!"}</p>
 <p>Pontuação: <b>${score}</b></p>
 <button id="jogar">JOGAR NOVAMENTE</button>`;
 document.getElementById("jogar").onclick=restart;
 document.getElementById("controles").style.display="none";
 document.getElementById("hud").style.display="none";
 document.getElementById("minimapa").style.display="none";
 document.getElementById("mirinha").style.display="none";
}

function restart(){
 if(player)scene.remove(player);
 enemies.forEach(e=>scene.remove(e.obj));
 enemies=[];

 health=100;
 score=0;
 ammo=12;
 reserve=60;
 reloading=false;
 ended=false;
 started=true;
 shotAt=0;
 powerAt=0;
 camAngle=0;
 jumping=false;

 player=makeHumanoid(heroes[selected]);
 player.position.set(0,0,0);
 scene.add(player);

 for(let i=0;i<8;i++){
  const a=Math.random()*Math.PI*2;
  const d=22+Math.random()*32;
  enemies.push(createEnemy(Math.cos(a)*d,Math.sin(a)*d));
 }

 document.getElementById("mensagem").style.display="none";
 document.getElementById("hud").style.display="block";
 document.getElementById("controles").style.display="block";
 document.getElementById("minimapa").style.display="block";
 document.getElementById("mirinha").style.display="block";
 document.getElementById("ajuda").textContent="Derrote todos os adversários!";
 updateHUD();
}

document.getElementById("jogar").onclick=restart;

function hitEnemy(e,damage){
 if(!e.alive)return;
 e.hp-=damage;
 score+=10;

 // Efeito visual de impacto
 e.obj.scale.set(1.08,.96,1.08);
 setTimeout(()=>{
  if(e.obj)e.obj.scale.set(1,1,1);
 },100);

 if(e.hp<=0){
  e.alive=false;
  e.obj.visible=false;
  score+=90;
  document.getElementById("ajuda").textContent="Adversário derrotado!";
 }
}

function shoot(){
 if(!started||ended||reloading)return;
 if(performance.now()-shotAt<320)return;

 if(ammo<=0){
  document.getElementById("ajuda").textContent="Sem munição! Recarregue.";
  return;
 }

 shotAt=performance.now();
 ammo--;

 const forward=new THREE.Vector3(
  Math.sin(camAngle),0,Math.cos(camAngle)
 );

 let target=null;
 let best=8;

 enemies.forEach(e=>{
  if(!e.alive)return;

  const delta=e.obj.position.clone().sub(player.position);
  const dist=delta.length();
  delta.y=0;
  delta.normalize();

  if(forward.dot(delta)>.72&&dist<best){
   best=dist;
   target=e;
  }
 });

 if(target)hitEnemy(target,1);

 updateHUD();
 if(enemies.every(e=>!e.alive))endGame(true);
}

function special(){
 if(!started||ended)return;
 if(performance.now()-powerAt<4500)return;

 powerAt=performance.now();

 enemies.forEach(e=>{
  if(e.alive&&player.position.distanceTo(e.obj.position)<9)
   hitEnemy(e,2);
 });

 updateHUD();
 document.getElementById("ajuda").textContent=
 heroes[selected].power+" ativado!";

 if(enemies.every(e=>!e.alive))endGame(true);
}

function reload(){
 if(!started||ended||reloading||ammo===12||reserve<=0)return;

 reloading=true;
 document.getElementById("ajuda").textContent="Recarregando...";

 setTimeout(()=>{
  if(ended)return;
  const n=Math.min(12-ammo,reserve);
  ammo+=n;
  reserve-=n;
  reloading=false;
  updateHUD();
  document.getElementById("ajuda").textContent="Munição carregada!";
 },1100);
}

function jump(){
 if(!started||ended||jumping)return;
 jumping=true;
 jumpV=7;
}

document.getElementById("btnAtaque").onpointerdown=e=>{
 e.preventDefault();shoot();
};
document.getElementById("btnEspecial").onpointerdown=e=>{
 e.preventDefault();special();
};
document.getElementById("btnPulo").onpointerdown=e=>{
 e.preventDefault();jump();
};
document.getElementById("btnRecarregar").onpointerdown=e=>{
 e.preventDefault();reload();
};

document.addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;
 if(e.key===" ")jump();
 if(e.key.toLowerCase()==="j")shoot();
 if(e.key.toLowerCase()==="k")special();
 if(e.key.toLowerCase()==="r")reload();
});

document.addEventListener("keyup",e=>{
 keys[e.key.toLowerCase()]=false;
});

const joy=document.getElementById("joystick");
const pin=document.getElementById("pino");

function movePin(e){
 const r=joy.getBoundingClientRect();
 let x=e.clientX-(r.left+r.width/2);
 let y=e.clientY-(r.top+r.height/2);
 const lim=36;
 const d=Math.hypot(x,y);

 if(d>lim){
  x=x/d*lim;
  y=y/d*lim;
 }

 move.x=x/lim;
 move.y=y/lim;
 pin.style.left=(35+x)+"px";
 pin.style.top=(35+y)+"px";
}

joy.onpointerdown=e=>{
 e.preventDefault();
 joyOn=true;
 joyId=e.pointerId;
 joy.setPointerCapture(e.pointerId);
 movePin(e);
};

joy.onpointermove=e=>{
 if(joyOn&&e.pointerId===joyId)movePin(e);
};

function stopJoy(){
 joyOn=false;
 move.x=move.y=0;
 pin.style.left="35px";
 pin.style.top="35px";
}

joy.onpointerup=stopJoy;
joy.onpointercancel=stopJoy;

renderer.domElement.addEventListener("pointerdown",e=>{
 if(!started)return;
 if(e.clientX<innerWidth*.65&&e.clientY>innerHeight*.35)return;
 drag=true;
 lastX=e.clientX;
});

renderer.domElement.addEventListener("pointermove",e=>{
 if(drag){
  camAngle-=(e.clientX-lastX)*.006;
  lastX=e.clientX;
 }
});

function stopDrag(){drag=false}
renderer.domElement.addEventListener("pointerup",stopDrag);
renderer.domElement.addEventListener("pointercancel",stopDrag);
renderer.domElement.addEventListener("contextmenu",e=>e.preventDefault());

function minimap(){
 if(!player)return;

 const c=document.getElementById("minimapa");
 const ctx=c.getContext("2d");

 ctx.clearRect(0,0,100,100);
 ctx.fillStyle="#285b38";
 ctx.fillRect(0,0,100,100);

 ctx.fillStyle="#b6a47c";
 ctx.fillRect(47,0,6,100);

 ctx.fillStyle="#54dfff";
 ctx.beginPath();
 ctx.arc(50+player.position.x*.48,
 50+player.position.z*.48,4,0,7);
 ctx.fill();

 ctx.fillStyle="#ff5555";
 enemies.forEach(e=>{
  if(e.alive){
   ctx.beginPath();
   ctx.arc(50+e.obj.position.x*.48,
   50+e.obj.position.z*.48,2.5,0,7);
   ctx.fill();
  }
 });
}

